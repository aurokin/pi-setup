{
  "name": "pi-setup",
  "private": true,
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "acorn": "^8.17.0",
    "firecrawl": "^4.30.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.2",
    "@types/node": "^26.1.1",
    "effect": "^4.0.0-beta.101",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"e2e/**/*.ts\" \"tools/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"e2e/**/*.ts\" \"tools/**/*.ts\" \"*.json\"",
    "test": "node --test --experimental-strip-types extensions/*/*.test.ts tools/*/*.test.ts && pnpm --filter file-search test",
    "prompt": "node --experimental-strip-types tools/prompt-inspector/inspect.ts",
    "render:policy": "node --experimental-strip-types --input-type=module -e \"const m = await import('./extensions/shared/engineering-policy.ts'); const fs = await import('node:fs'); fs.writeFileSync('extensions/shared/engineering-policy.md', m.ENGINEERING_POLICY + '\\n');\"",
    "test:e2e": "node --test --experimental-strip-types e2e/*.test.ts",
    "profile:slim": "./scripts/slim-profile.sh",
    "prepare": "effect-tsgo patch"
  },
  "packageManager": "pnpm@11.17.0"
}
