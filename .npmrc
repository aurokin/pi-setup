# A flat node_modules, as npm builds. Not a concession to habit — extensions are
# loaded into pi's own process, so they must use the same @earendil-works/*
# instance pi is running. pnpm's default isolated layout would have each
# extension declare and resolve its own copy of the SDK, which is exactly the
# version skew that would break them.
#
# Disk is still shared: hoisted or not, pnpm hardlinks every package from the
# global store, so one copy on disk serves every project on this machine.
node-linker=hoisted
